--[[
    JJS No Stun (Optimized + Floating HUB Button + Draggable)
]]

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

local TOGGLE_KEY = Enum.KeyCode.H
local STUN_KEYWORDS = { "stun", "ragdoll", "freeze", "frozen", "paraly", "immobil", "nomove", "cantmove", "knockdown" }

-- Dọn bản chạy trước
local env = (getgenv and getgenv()) or _G
if env.JJS_NoStunCleanup then pcall(env.JJS_NoStunCleanup) end

local parentGui = (gethui and gethui()) or CoreGui
local connections = {}
local function track(c) table.insert(connections, c) return c end

local settings = {
    Enabled = false,
    Ragdoll = true,
    Hitstop = true,
    Flags = true,
    RestoreMove = true,
}

local T = {
    Bg = Color3.fromRGB(13, 13, 19),
    Panel = Color3.fromRGB(19, 19, 28),
    Element = Color3.fromRGB(26, 26, 38),
    Hover = Color3.fromRGB(36, 36, 52),
    Off = Color3.fromRGB(52, 52, 72),
    Stroke = Color3.fromRGB(44, 44, 64),
    Accent = Color3.fromRGB(0, 229, 255),
    Good = Color3.fromRGB(70, 220, 120),
    Text = Color3.fromRGB(238, 238, 245),
    Sub = Color3.fromRGB(150, 150, 172),
    Danger = Color3.fromRGB(255, 70, 70),
}

local function create(class, props, children)
    local inst = Instance.new(class)
    if inst:IsA("GuiObject") then inst.BorderSizePixel = 0 end
    local parent
    for k, v in pairs(props or {}) do
        if k == "Parent" then parent = v else inst[k] = v end
    end
    for _, ch in ipairs(children or {}) do ch.Parent = inst end
    inst.Parent = parent
    return inst
end

local function corner(r) return create("UICorner", { CornerRadius = UDim.new(0, r) }) end
local function stroke(color, thickness)
    return create("UIStroke", { Color = color, Thickness = thickness or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function makeDraggable(handle, target)
    local dragging, moved = false, false
    local startPos, startInput

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            startInput = input.Position
            startPos = target.Position
        end
    end)
    track(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - startInput
            if delta.Magnitude > 5 then moved = true end
            if moved then
                target.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
    return function() return moved end
end

-- GUI chính và GUI nút lơ lửng
local MainGui = create("ScreenGui", { Name = "JJS_NoStunMain", ResetOnSpawn = false, Parent = parentGui })
local FloatGui = create("ScreenGui", { Name = "JJS_NoStunFloat", ResetOnSpawn = false, Enabled = false, Parent = parentGui })

local Panel = create("Frame", {
    Parent = MainGui,
    Position = UDim2.new(0.5, -155, 0.5, -190),
    Size = UDim2.new(0, 310, 0, 380),
    BackgroundColor3 = T.Bg,
}, { corner(10), stroke(T.Accent, 1.5) })

local TopBar = create("Frame", { Parent = Panel, Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = T.Panel }, { corner(10) })
create("Frame", { Parent = TopBar, Position = UDim2.new(0, 0, 1, -10), Size = UDim2.new(1, 0, 0, 10), BackgroundColor3 = T.Panel })
create("TextLabel", {
    Parent = TopBar, BackgroundTransparency = 1,
    Position = UDim2.new(0, 14, 0, 0), Size = UDim2.new(1, -80, 1, 0),
    Font = Enum.Font.GothamBold, Text = "🧍 JJS No Stun", TextSize = 14,
    TextColor3 = T.Accent, TextXAlignment = Enum.TextXAlignment.Left,
})

local function topButton(text, xOff, hoverColor, cb)
    local b = create("TextButton", {
        Parent = TopBar, AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, xOff, 0.5, 0), Size = UDim2.new(0, 26, 0, 26),
        BackgroundColor3 = T.Element, Font = Enum.Font.GothamBold, Text = text,
        TextSize = 12, TextColor3 = T.Text, AutoButtonColor = false,
    }, { corner(6) })
    b.MouseEnter:Connect(function() b.BackgroundColor3 = hoverColor end)
    b.MouseLeave:Connect(function() b.BackgroundColor3 = T.Element end)
    b.MouseButton1Click:Connect(cb)
    return b
end

makeDraggable(TopBar, Panel)

-- Nút lơ lửng "HUB"
local FloatBtn = create("TextButton", {
    Parent = FloatGui,
    BackgroundColor3 = T.Bg,
    BackgroundTransparency = 0.1,
    Position = UDim2.new(0, 50, 0, 200),
    Size = UDim2.new(0, 56, 0, 56),
    Font = Enum.Font.GothamBold,
    Text = "NO STUN",
    TextSize = 10,
    TextColor3 = T.Accent,
    AutoButtonColor = false,
}, { create("UICorner", { CornerRadius = UDim.new(1, 0) }), stroke(T.Accent, 2) })
local floatWasDragged = makeDraggable(FloatBtn, FloatBtn)

local function setVisible(state)
    MainGui.Enabled = state
    FloatGui.Enabled = not state
end

topButton("X", -10, T.Danger, function()
    if env.JJS_NoStunCleanup then env.JJS_NoStunCleanup() end
end)
topButton("–", -42, T.Hover, function() setVisible(false) end)

FloatBtn.MouseButton1Click:Connect(function()
    if floatWasDragged() then return end
    setVisible(true)
end)

local List = create("ScrollingFrame", {
    Parent = Panel, BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, 48),
    Size = UDim2.new(1, -20, 1, -58), CanvasSize = UDim2.new(0, 0, 0, 0),
    AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 3, ScrollBarImageColor3 = T.Accent,
}, {
    create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }),
})

local StatusLabel = create("TextLabel", {
    Parent = List, LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1,
    Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = T.Sub, TextXAlignment = Enum.TextXAlignment.Left,
    Text = "Trạng thái: TẮT",
})

local function refreshStatus()
    StatusLabel.Text = ("No Stun: %s  ·  Phím: %s"):format(settings.Enabled and "BẬT" or "TẮT", TOGGLE_KEY.Name)
    StatusLabel.TextColor3 = settings.Enabled and T.Good or T.Sub
end

local function toggleRow(text, default, order, callback)
    local f = create("Frame", { Parent = List, LayoutOrder = order, Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.Element }, { corner(8) })
    create("TextLabel", {
        Parent = f, BackgroundTransparency = 1, Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(1, -70, 1, 0), Font = Enum.Font.Gotham, Text = text, TextSize = 12,
        TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left,
    })
    local pill = create("Frame", {
        Parent = f, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.new(0, 40, 0, 20), BackgroundColor3 = T.Off,
    }, { corner(10) })
    local knob = create("Frame", {
        Parent = pill, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.new(0, 14, 0, 14), BackgroundColor3 = T.Text,
    }, { corner(7) })
    local hit = create("TextButton", { Parent = f, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "" })

    local value = default
    local function render()
        pill.BackgroundColor3 = value and T.Accent or T.Off
        knob.Position = value and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
    end
    hit.MouseButton1Click:Connect(function()
        value = not value
        render()
        callback(value)
    end)
    render()
end

toggleRow("No Stun (Bật/Tắt)", false, 1, function(v) settings.Enabled = v refreshStatus() end)
toggleRow("Gỡ Ragdoll / Ngã", true, 2, function(v) settings.Ragdoll = v end)
toggleRow("Gỡ Hitstop (Đứng hình)", true, 3, function(v) settings.Hitstop = v end)
toggleRow("Gỡ Cờ Stun (Value/Attr)", true, 4, function(v) settings.Flags = v end)
toggleRow("Khôi phục tốc độ chạy", true, 5, function(v) settings.RestoreMove = v end)

refreshStatus()

-- LOGIC CHỐNG STUN TỐI ƯU
local function hookCharacter(char)
    local hum = char:WaitForChild("Humanoid", 5)
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    if not (hum and hrp) then return end

    track(hum.StateChanged:Connect(function(old, new)
        if not settings.Enabled or not settings.Ragdoll then return end
        if new == Enum.HumanoidStateType.Ragdoll or new == Enum.HumanoidStateType.FallingDown or hum.PlatformStand then
            hum.PlatformStand = false
            hrp.Anchored = false
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
    end))

    track(char.DescendantAdded:Connect(function(d)
        if not settings.Enabled then return end
        if settings.Ragdoll and d:IsA("BallSocketConstraint") then
            task.defer(function() pcall(function() d:Destroy() end) end)
        elseif settings.Flags and (d:IsA("BoolValue") or d:IsA("NumberValue") or d:IsA("IntValue")) then
            local name = string.lower(d.Name)
            for _, k in ipairs(STUN_KEYWORDS) do
                if name:find(k) then
                    task.defer(function()
                        pcall(function()
                            if d:IsA("BoolValue") then d.Value = false else d.Value = 0 end
                        end)
                    end)
                    break
                end
            end
        end
    end))
end

if LocalPlayer.Character then task.spawn(hookCharacter, LocalPlayer.Character) end
track(LocalPlayer.CharacterAdded:Connect(function(char) task.spawn(hookCharacter, char) end))

track(RunService.Heartbeat:Connect(function()
    if not settings.Enabled then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    if settings.RestoreMove and hum.WalkSpeed < 2 then
        hum.WalkSpeed = 16
    end

    if settings.Hitstop then
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            for _, trackAnim in ipairs(animator:GetPlayingAnimationTracks()) do
                if trackAnim.Speed < 0.05 then
                    trackAnim:AdjustSpeed(1)
                end
            end
        end
    end
end))

local function cleanup()
    settings.Enabled = false
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    table.clear(connections)
    MainGui:Destroy()
    FloatGui:Destroy()
    env.JJS_NoStunCleanup = nil
end
env.JJS_NoStunCleanup = cleanup

track(UserInputService.InputBegan:Connect(function(input, gp)
    if not gp and input.KeyCode == TOGGLE_KEY then
        settings.Enabled = not settings.Enabled
        refreshStatus()
    end
end))
