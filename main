--[[
    JJS No Stun
    Gỡ các kiểu "đứng im / ragdoll" phía client:
      - Ragdoll: PlatformStand, trạng thái Ragdoll/FallingDown, BallSocketConstraint, Motor6D bị tắt
      - Hitstop / đứng hình: animation bị đặt Speed = 0
      - Cờ stun: Value / Attribute có tên chứa "stun", "ragdoll", "freeze"...
      - WalkSpeed / Jump bị đặt về 0 -> khôi phục
      - (tuỳ chọn) lực đẩy/giữ: BodyVelocity, AlignPosition...

    Giới hạn: chỉ gỡ được thứ game áp lên máy bạn. Nếu server giữ vị trí nhân vật
    (skill hút, grab) thì client không thắng được.
    Bật "Chẩn đoán" để xem game thay đổi gì trên nhân vật khi bạn bị đánh.
]]

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

-- ===== Cấu hình =====
local TOGGLE_KEY = Enum.KeyCode.H
local STUN_KEYWORDS = { "stun", "ragdoll", "freeze", "frozen", "paraly", "immobil", "nomove", "cantmove", "knockdown" }
local MAX_LOG = 40

-- ===== Dọn bản chạy trước =====
local env = (getgenv and getgenv()) or _G
if env.JJS_NoStunCleanup then
    pcall(env.JJS_NoStunCleanup)
end

local parentGui = (gethui and gethui()) or CoreGui
local connections, charConns = {}, {}
local function track(c) table.insert(connections, c) return c end

local settings = {
    Enabled = false,
    Ragdoll = true,
    Hitstop = true,
    Flags = true,
    RestoreMove = true,
    ZeroSpeedIsStun = true,
    StripMovers = false,
    WalkOverride = 0,
    Diag = false,
}

-- ===== Theme + helper =====
local T = {
    Bg = Color3.fromRGB(13, 13, 19),
    Panel = Color3.fromRGB(19, 19, 28),
    Element = Color3.fromRGB(26, 26, 38),
    Hover = Color3.fromRGB(36, 36, 52),
    Off = Color3.fromRGB(52, 52, 72),
    Stroke = Color3.fromRGB(44, 44, 64),
    Accent = Color3.fromRGB(0, 229, 255),
    Good = Color3.fromRGB(70, 220, 120),
    Text = Color3.fromRGB(238, 238, 245),
    Sub = Color3.fromRGB(150, 150, 172),
}

local function create(class, props, children)
    local inst = Instance.new(class)
    if inst:IsA("GuiObject") then inst.BorderSizePixel = 0 end
    local parent
    for k, v in pairs(props or {}) do
        if k == "Parent" then parent = v else inst[k] = v end
    end
    for _, ch in ipairs(children or {}) do ch.Parent = inst end
    inst.Parent = parent
    return inst
end

local function tween(inst, t, props)
    TweenService:Create(inst, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function corner(r) return create("UICorner", { CornerRadius = UDim.new(0, r) }) end

-- ===== GUI =====
for _, root in ipairs({ CoreGui, parentGui }) do
    local old = root:FindFirstChild("JJS_NoStun")
    if old then old:Destroy() end
end

local Gui = create("ScreenGui", { Name = "JJS_NoStun", ResetOnSpawn = false, Parent = parentGui })

local Panel = create("Frame", {
    Parent = Gui,
    Position = UDim2.new(0, 360, 0, 90),
    Size = UDim2.new(0, 310, 0, 480),
    BackgroundColor3 = T.Bg,
}, {
    corner(10),
    create("UIStroke", { Color = T.Accent, Thickness = 1.5, Transparency = 0.3 }),
})

local TopBar = create("Frame", { Parent = Panel, Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = T.Panel }, { corner(10) })
create("Frame", { Parent = TopBar, Position = UDim2.new(0, 0, 1, -10), Size = UDim2.new(1, 0, 0, 10), BackgroundColor3 = T.Panel })
create("TextLabel", {
    Parent = TopBar, BackgroundTransparency = 1,
    Position = UDim2.new(0, 14, 0, 0), Size = UDim2.new(1, -60, 1, 0),
    Font = Enum.Font.GothamBold, Text = "🧍 JJS No Stun", TextSize = 14,
    TextColor3 = T.Accent, TextXAlignment = Enum.TextXAlignment.Left,
})
local CloseBtn = create("TextButton", {
    Parent = TopBar, AnchorPoint = Vector2.new(1, 0.5),
    Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0, 26, 0, 26),
    BackgroundColor3 = T.Element, Font = Enum.Font.GothamBold, Text = "X",
    TextSize = 12, TextColor3 = T.Text, AutoButtonColor = false,
}, { corner(6) })

do -- kéo thả
    local dragging, startInput, startPos = false, nil, nil
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startInput = input.Position
            startPos = Panel.Position
        end
    end)
    track(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - startInput
            Panel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

local List = create("ScrollingFrame", {
    Parent = Panel,
    BackgroundTransparency = 1,
    Position = UDim2.new(0, 10, 0, 48),
    Size = UDim2.new(1, -20, 1, -58),
    CanvasSize = UDim2.new(0, 0, 0, 0),
    AutomaticCanvasSize = Enum.AutomaticSize.Y,
    ScrollBarThickness = 3,
    ScrollBarImageColor3 = T.Accent,
}, {
    create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }),
    create("UIPadding", { PaddingRight = UDim.new(0, 6) }),
})

local StatusLabel = create("TextLabel", {
    Parent = List, LayoutOrder = 0,
    Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1,
    Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = T.Sub,
    TextXAlignment = Enum.TextXAlignment.Left, Text = "",
})
local DebugLabel = create("TextLabel", {
    Parent = List, LayoutOrder = 1,
    Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1,
    Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = T.Sub, TextWrapped = true,
    TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
    Text = "Chưa gỡ gì.",
})

local fixCount = 0
local function refreshStatus()
    StatusLabel.Text = ("No Stun: %s  ·  Số lần gỡ: %d  ·  Phím: %s"):format(
        settings.Enabled and "BẬT" or "TẮT", fixCount, TOGGLE_KEY.Name)
    StatusLabel.TextColor3 = settings.Enabled and T.Good or T.Sub
end
local function setDebug(text)
    DebugLabel.Text = text
end

local statusToken = 0
local function flashStatus(text)
    statusToken += 1
    local my = statusToken
    StatusLabel.Text = text
    StatusLabel.TextColor3 = T.Accent
    task.delay(2, function()
        if my == statusToken then refreshStatus() end
    end)
end

local function sectionLabel(text, order)
    create("TextLabel", {
        Parent = List, LayoutOrder = order,
        Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold, Text = string.upper(text), TextSize = 11,
        TextColor3 = T.Accent, TextXAlignment = Enum.TextXAlignment.Left,
    })
end

local function toggleRow(text, default, order, callback)
    local f = create("Frame", { Parent = List, LayoutOrder = order, Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.Element }, { corner(8) })
    create("TextLabel", {
        Parent = f, BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -70, 1, 0),
        Font = Enum.Font.Gotham, Text = text, TextSize = 12, TextWrapped = true,
        TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left,
    })
    local pill = create("Frame", {
        Parent = f, AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 40, 0, 20),
        BackgroundColor3 = T.Off,
    }, { corner(10) })
    local knob = create("Frame", {
        Parent = pill, AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.new(0, 14, 0, 14),
        BackgroundColor3 = T.Text,
    }, { corner(7) })
    local hit = create("TextButton", { Parent = f, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "" })

    local value = default
    local function render()
        tween(pill, 0.15, { BackgroundColor3 = value and T.Accent or T.Off })
        tween(knob, 0.15, { Position = value and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) })
    end
    local function set(v, silent)
        value = v
        render()
        if not silent then callback(v) end
    end
    hit.MouseButton1Click:Connect(function() set(not value) end)
    render()
    return set
end

local function sliderRow(text, min, max, default, inc, suffix, order, callback)
    local f = create("Frame", { Parent = List, LayoutOrder = order, Size = UDim2.new(1, 0, 0, 50), BackgroundColor3 = T.Element }, { corner(8) })
    create("TextLabel", {
        Parent = f, BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 5), Size = UDim2.new(1, -90, 0, 18),
        Font = Enum.Font.Gotham, Text = text, TextSize = 12,
        TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left,
    })
    local valLabel = create("TextLabel", {
        Parent = f, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, 5), Size = UDim2.new(0, 70, 0, 18),
        Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = T.Accent,
        TextXAlignment = Enum.TextXAlignment.Right, Text = "",
    })
    local bar = create("Frame", {
        Parent = f, Position = UDim2.new(0, 12, 0, 32), Size = UDim2.new(1, -24, 0, 6),
        BackgroundColor3 = T.Off,
    }, { corner(3) })
    local fill = create("Frame", { Parent = bar, Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = T.Accent }, { corner(3) })
    local knob = create("Frame", {
        Parent = bar, AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(0, 14, 0, 14),
        BackgroundColor3 = T.Text,
    }, { corner(7) })
    local hit = create("TextButton", {
        Parent = f, Position = UDim2.new(0, 6, 0, 22), Size = UDim2.new(1, -12, 0, 26),
        BackgroundTransparency = 1, Text = "",
    })

    local value = default
    local function render()
        local a = (value - min) / (max - min)
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        valLabel.Text = (value == 0 and suffix == " (tự động)") and "Tự động" or (tostring(value) .. suffix)
    end
    local function set(v)
        v = math.clamp(math.floor(v / inc + 0.5) * inc, min, max)
        value = tonumber(string.format("%.3f", v))
        render()
        callback(value)
    end
    local sliding = false
    local function fromX(x)
        local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        set(min + a * (max - min))
    end
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            fromX(input.Position.X)
        end
    end)
    track(UserInputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            fromX(input.Position.X)
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end))
    render()
end

local function buttonRow(text, order, callback)
    local b = create("TextButton", {
        Parent = List, LayoutOrder = order,
        Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.Element,
        Font = Enum.Font.GothamSemibold, Text = text, TextSize = 12,
        TextColor3 = T.Text, AutoButtonColor = false,
    }, { corner(8) })
    b.MouseEnter:Connect(function() tween(b, 0.12, { BackgroundColor3 = T.Hover }) end)
    b.MouseLeave:Connect(function() tween(b, 0.12, { BackgroundColor3 = T.Element }) end)
    b.MouseButton1Click:Connect(callback)
end

-- ===== Log chẩn đoán =====
local logRows = {}
local logN = 0
local t0 = os.clock()
local lastLogText, lastLogTime = nil, 0

local function addLog(text)
    local now = os.clock()
    if text == lastLogText and now - lastLogTime < 0.5 then return end
    lastLogText, lastLogTime = text, now

    logN += 1
    local line = ("[%.1f] %s"):format(now - t0, text)
    local row = create("TextLabel", {
        Parent = List, LayoutOrder = 100 + logN,
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 11,
        TextWrapped = true, TextColor3 = T.Sub, TextXAlignment = Enum.TextXAlignment.Left,
        Text = line,
    })
    table.insert(logRows, { row = row, text = line })
    if #logRows > MAX_LOG then
        local first = table.remove(logRows, 1)
        first.row:Destroy()
    end
end

local function logEvent(text)
    if settings.Diag then addLog(text) end
end

-- ===== Logic gỡ stun =====
local function nameIsStun(name)
    local n = string.lower(name)
    for _, k in ipairs(STUN_KEYWORDS) do
        if n:find(k, 1, true) then return true end
    end
    return false
end

local MOVER_CLASSES = {
    LinearVelocity = true, AngularVelocity = true, AlignPosition = true,
    AlignOrientation = true, VectorForce = true,
}

local WATCH_CLASSES = {
    BodyVelocity = true, BodyPosition = true, BodyGyro = true, BodyForce = true,
    BodyAngularVelocity = true, BodyThrust = true,
    LinearVelocity = true, AngularVelocity = true, AlignPosition = true,
    AlignOrientation = true, VectorForce = true,
    BallSocketConstraint = true,
    BoolValue = true, IntValue = true, NumberValue = true, StringValue = true,
}

local needsScan = true

local function clearRagdoll(char)
    local did = nil
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BallSocketConstraint") then
            d:Destroy()
            did = "ragdoll constraint"
        elseif d:IsA("Motor6D") and not d.Enabled then
            d.Enabled = true
            did = "Motor6D " .. d.Name
        end
    end
    return did
end

local function clearFlags(char, hum, hrp)
    local did = nil
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BoolValue") and d.Value and nameIsStun(d.Name) then
            d.Value = false
            did = d.Name
        elseif (d:IsA("NumberValue") or d:IsA("IntValue")) and d.Value ~= 0 and nameIsStun(d.Name) then
            d.Value = 0
            did = d.Name
        end
    end
    for _, inst in ipairs({ char, hum, hrp }) do
        for name, val in pairs(inst:GetAttributes()) do
            if nameIsStun(name) then
                if val == true then
                    inst:SetAttribute(name, false)
                    did = name
                elseif type(val) == "number" and val ~= 0 then
                    inst:SetAttribute(name, 0)
                    did = name
                end
            end
        end
    end
    return did
end

local function stripMovers(char)
    local did = nil
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BodyMover") or MOVER_CLASSES[d.ClassName] then
            d:Destroy()
            did = d.ClassName
        end
    end
    return did
end

local function applyStateBlock(hum, on)
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, not on)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, not on)
    end)
end

local baseWalk = 16
local baseJump = { JumpPower = 50, JumpHeight = 7.2 }
local lastScan = 0

track(RunService.Heartbeat:Connect(function()
    if not settings.Enabled then return end

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and hrp) or hum.Health <= 0 then return end

    local signal = false
    local function fixed(what)
        signal = true
        fixCount += 1
        setDebug("Đã gỡ: " .. what)
        refreshStatus()
    end

    -- Ragdoll
    if settings.Ragdoll then
        if hum.PlatformStand then
            hum.PlatformStand = false
            fixed("PlatformStand")
        end
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.FallingDown then
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            fixed("trạng thái " .. st.Name)
        end
        if hrp.Anchored then
            hrp.Anchored = false
            fixed("HumanoidRootPart.Anchored")
        end
    end

    -- Quét định kỳ: constraint, cờ stun, lực giữ
    local now = os.clock()
    if needsScan or now - lastScan > 0.2 then
        lastScan = now
        needsScan = false
        if settings.Ragdoll then
            local r = clearRagdoll(char)
            if r then fixed(r) end
        end
        if settings.Flags then
            local f = clearFlags(char, hum, hrp)
            if f then fixed("cờ " .. f) end
        end
        if settings.StripMovers then
            local m = stripMovers(char)
            if m then fixed(m) end
        end
    end

    -- Hitstop: animation bị đặt Speed = 0
    if settings.Hitstop then
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
                if t.Speed < 0.05 then
                    local nm = (t.Animation and t.Animation.Name) or t.Name
                    t:AdjustSpeed(1)
                    fixed("animation đứng hình: " .. tostring(nm))
                    logEvent("Anim Speed 0: " .. tostring(nm))
                end
            end
        end
    end

    -- Khôi phục tốc độ chạy / nhảy
    if settings.RestoreMove then
        local walk = hum.WalkSpeed
        local zeroStun = settings.ZeroSpeedIsStun and walk < 1
        if signal or zeroStun then
            local target = settings.WalkOverride > 0 and settings.WalkOverride or baseWalk
            if walk < target then
                hum.WalkSpeed = target
                if zeroStun then fixed("WalkSpeed = 0") end
            end
        elseif walk >= 8 and walk <= 50 then
            baseWalk = walk
        end

        local jprop = hum.UseJumpPower and "JumpPower" or "JumpHeight"
        local jv = hum[jprop]
        local jmin = (jprop == "JumpPower") and 1 or 0.1
        if signal or (settings.ZeroSpeedIsStun and jv < jmin) then
            if jv < baseJump[jprop] then
                hum[jprop] = baseJump[jprop]
            end
        elseif jv >= jmin then
            baseJump[jprop] = jv
        end
    end
end))

-- ===== Theo dõi nhân vật (chẩn đoán + phát hiện instance mới) =====
local function clearCharConns()
    for _, c in ipairs(charConns) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(charConns)
end

local function hookCharacter(char)
    clearCharConns()
    needsScan = true
    local hum = char:WaitForChild("Humanoid", 10)
    local hrp = char:WaitForChild("HumanoidRootPart", 10)
    if not (hum and hrp) then return end

    if settings.Enabled and settings.Ragdoll then
        applyStateBlock(hum, true)
    end

    local function add(c) table.insert(charConns, c) end

    for _, prop in ipairs({ "WalkSpeed", "JumpPower", "JumpHeight", "PlatformStand", "AutoRotate" }) do
        local last = hum[prop]
        add(hum:GetPropertyChangedSignal(prop):Connect(function()
            local v = hum[prop]
            logEvent(("Humanoid.%s: %s → %s"):format(prop, tostring(last), tostring(v)))
            last = v
        end))
    end
    add(hum.StateChanged:Connect(function(old, new)
        logEvent(("State: %s → %s"):format(old.Name, new.Name))
    end))
    add(hrp:GetPropertyChangedSignal("Anchored"):Connect(function()
        logEvent("HumanoidRootPart.Anchored = " .. tostring(hrp.Anchored))
    end))
    for _, inst in ipairs({ char, hum, hrp }) do
        add(inst.AttributeChanged:Connect(function(attr)
            logEvent(("Attribute %s.%s = %s"):format(inst.Name, attr, tostring(inst:GetAttribute(attr))))
        end))
    end

    local function watchValue(v)
        add(v.Changed:Connect(function(val)
            logEvent(("%s \"%s\" = %s"):format(v.ClassName, v.Name, tostring(val)))
            needsScan = true
        end))
    end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("ValueBase") then watchValue(d) end
    end
    add(char.DescendantAdded:Connect(function(d)
        if WATCH_CLASSES[d.ClassName] then
            needsScan = true
            logEvent(("+ %s \"%s\" (trong %s)"):format(d.ClassName, d.Name, d.Parent and d.Parent.Name or "?"))
            if d:IsA("ValueBase") then watchValue(d) end
        end
    end))
end

if LocalPlayer.Character then
    task.spawn(hookCharacter, LocalPlayer.Character)
end
track(LocalPlayer.CharacterAdded:Connect(function(char)
    task.spawn(hookCharacter, char)
end))

-- ===== Điều khiển =====
local function currentHum()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

sectionLabel("Điều khiển", 2)
local setEnabled = toggleRow("No Stun (phím H)", false, 3, function(v)
    settings.Enabled = v
    local hum = currentHum()
    if hum then applyStateBlock(hum, v and settings.Ragdoll) end
    needsScan = true
    refreshStatus()
end)
toggleRow("Gỡ ragdoll (PlatformStand, constraint, Anchored)", true, 4, function(v)
    settings.Ragdoll = v
    local hum = currentHum()
    if hum then applyStateBlock(hum, v and settings.Enabled) end
end)
toggleRow("Gỡ hitstop / đứng hình khi đánh trúng", true, 5, function(v) settings.Hitstop = v end)
toggleRow("Gỡ cờ stun (Value / Attribute)", true, 6, function(v) settings.Flags = v end)
toggleRow("Khôi phục tốc độ chạy / nhảy", true, 7, function(v) settings.RestoreMove = v end)
toggleRow("Coi tốc độ ≈ 0 là stun", true, 8, function(v) settings.ZeroSpeedIsStun = v end)
toggleRow("Gỡ lực đẩy/giữ (có thể hỏng dash!)", false, 9, function(v) settings.StripMovers = v end)

sectionLabel("Tuỳ chỉnh", 10)
sliderRow("Tốc độ chạy khi gỡ stun", 0, 60, 0, 1, " (tự động)", 11, function(v) settings.WalkOverride = v end)

sectionLabel("Chẩn đoán", 12)
toggleRow("Ghi log thay đổi trên nhân vật", false, 13, function(v)
    settings.Diag = v
    flashStatus(v and "Ghi log: hãy để người khác đánh bạn / dính skill hút" or "Đã tắt ghi log")
end)
buttonRow("📋 Copy log", 14, function()
    local lines = {}
    for _, r in ipairs(logRows) do table.insert(lines, r.text) end
    local s = table.concat(lines, "\n")
    print(s)
    local copy = setclipboard or toclipboard
    if copy then
        copy(s)
        flashStatus("Đã copy " .. #lines .. " dòng log")
    else
        flashStatus("Executor không có clipboard, đã in ra console (F9)")
    end
end)
buttonRow("🗑️ Xoá log", 15, function()
    for _, r in ipairs(logRows) do r.row:Destroy() end
    table.clear(logRows)
    flashStatus("Đã xoá log")
end)

refreshStatus()

-- ===== Phím tắt + dọn dẹp =====
track(UserInputService.InputBegan:Connect(function(input, gp)
    if not gp and input.KeyCode == TOGGLE_KEY then
        setEnabled(not settings.Enabled)
    end
end))

local function cleanup()
    settings.Enabled = false
    local hum = currentHum()
    if hum then applyStateBlock(hum, false) end
    clearCharConns()
    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(connections)
    Gui:Destroy()
    env.JJS_NoStunCleanup = nil
end
env.JJS_NoStunCleanup = cleanup
CloseBtn.MouseButton1Click:Connect(cleanup)
